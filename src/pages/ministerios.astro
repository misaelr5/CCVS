---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollAccent from '../components/ScrollAccent.astro';
import MinistryFeature from '../components/MinistryFeature.astro';
import { ministries } from '../data/ministries';
---
<BaseLayout title="Oración, Palabra y servicio" description="Conocé las actividades de Comunidad Cristiana Villa Sarmiento: oración, estudios bíblicos, niños, jóvenes, evangelismo y ayuda social.">
<section class="page-heading shell"><h1>Crecer en Cristo.<br /><span class="serif">Servir al prójimo.</span></h1><p>Jesús llamó a sus seguidores a hacer discípulos. En nuestra congregación compartimos la fe mediante la oración, el estudio de la Biblia y el servicio a nuestros vecinos.</p><p class="scripture-note">Inspirado en Mateo 28:19–20</p><ScrollAccent kind="horizontal" /><nav class="section-navigation" aria-label="Actividades">{ministries.map(item => <a href={`#${item.id}`}>{item.title.replace(/\.$/, '')}</a>)}</nav></section>
<div class="ministries-showcase shell section-gap"><h2>Ministerios.</h2><div class="ministries-showcase-list">{ministries.map((ministry,index) => <MinistryFeature ministry={ministry} index={index} />)}</div></div>
</BaseLayout>
