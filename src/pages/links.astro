---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaithIllustration from '../components/FaithIllustration.astro';
import ScrollAccent from '../components/ScrollAccent.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { hubLinks, externalLinks, isHttpsUrl, type Link } from '../data/links';
import SocialIcon from '../components/SocialIcon.astro';
const links: Link[] = [...hubLinks, ...externalLinks.filter(link=>isHttpsUrl(link.href))];
---
<BaseLayout title="Enlaces de la congregación" description="Horarios, ubicación y canales de Comunidad Cristiana Villa Sarmiento, Córdoba. Accedé a Facebook, YouTube y al Instagram de Jóvenes CCVS." compact>
<section class="links-hub"><Image src={site.logos.mother} alt="Emblema de Comunidad Cristiana" width={106} height={106} densities={[1, 2, 3]} format="webp" loading="eager" /><h1>Comunidad Cristiana<br /><span>Villa Sarmiento</span></h1><p>Queremos compartir con vos nuestra fe en Jesucristo.<br />Elegí por dónde empezar.</p><ScrollAccent kind="horizontal" /><FaithIllustration kind="dove" class="links-faith-sticker" /><nav aria-label="Enlaces de la iglesia">{links.map(link => <a href={link.href} class="link-button" target={isHttpsUrl(link.href)?'_blank':undefined} rel={isHttpsUrl(link.href)?'noopener noreferrer':undefined} data-astro-reload={isHttpsUrl(link.href)}><SocialIcon type={link.icon} /><span>{link.label}</span>{isHttpsUrl(link.href) && <span class="sr-only"> (abre en una pestaña nueva)</span>}</a>)}</nav><address>{site.address}</address><a class="hub-legal" href="/terminos-y-condiciones/">Términos y condiciones · borrador</a></section>
</BaseLayout>
