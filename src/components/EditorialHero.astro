---
import HeroVideo from './HeroVideo.astro';
import { editorial, site } from '../data/site';
import ScrollAccent from './ScrollAccent.astro';
---
<section class="editorial-hero shell"><HeroVideo /><div class="hero-copy"><h1><span class="hero-title-primary">{editorial.hero[0]}</span>{' '}<span class="hero-title-secondary">{editorial.hero[1]}</span></h1><p class="hero-welcome">{editorial.heroWelcome} <strong>{site.shortName}</strong></p><p class="hero-tagline">{editorial.heroTagline}</p><div class="hero-actions"><a class="pill" href="/visitanos/">Planificá tu visita</a><a class="hero-faith-link" href="/lo-que-creemos/">Conocé nuestra fe</a></div><ScrollAccent kind="diagonal" class="hero-accent" /></div></section>

<style>
 .hero-copy .hero-welcome { margin-top:28px; font-size:16px; font-weight:600; }
 .hero-welcome strong { display:inline-block; padding:1px 6px; border-radius:2px; background:#fff; color:#631918; font-weight:800; letter-spacing:.03em; }
 .hero-copy .hero-tagline { max-width:390px; margin-top:12px; font-size:18px; line-height:1.35; font-weight:500; }
 .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:8px 24px; margin-top:28px; }
 .hero-actions .pill { margin:0; }
 .hero-faith-link { display:inline-flex; align-items:center; min-height:48px; font-size:14px; text-underline-offset:5px; }
 @media(max-width:700px) { .hero-copy .hero-welcome { margin-top:24px; } .hero-copy .hero-tagline { max-width:320px; font-size:17px; } .hero-actions { margin-top:26px; gap:8px 18px; } }
</style>
