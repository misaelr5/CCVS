---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ScheduleList from '../components/ScheduleList.astro';
import Arrow from '../components/Arrow.astro';
import { site, isHttpsUrl } from '../data/site';
---
<BaseLayout title="Visitarnos" description={`Dirección y horarios de Comunidad Cristiana Villa Sarmiento. ${site.address}. Reunión principal: domingo 19:30.`}>
  <section class="page-intro simple-intro wrap"><p class="eyebrow">Vení a conocernos</p><h1>{site.visit.title}<br /><em>{site.visit.accent}</em></h1><p class="intro-text">{site.visit.text}</p></section>
  <section class="schedule-section wrap section-space" id="horarios"><SectionHeading eyebrow="Horarios de reunión" title="Un espacio" accent="para encontrarnos." /><ScheduleList /></section>
  <section class="visit-address wrap section-space"><div><span class="eyebrow">Dónde estamos</span><h2>Villa Sarmiento.<br /><em>Córdoba, Argentina.</em></h2><address>{site.address}</address>{site.mapUrl && isHttpsUrl(site.mapUrl) && <a class="button" href={site.mapUrl} rel="noopener noreferrer">Ver ubicación en el mapa <Arrow diagonal /></a>}</div><div class="first-visit"><p class="eyebrow">Tu primera visita</p><h3>Podés acercarte.</h3><p>{site.visit.firstVisit}</p><a class="text-link" href="/nosotros/">Conocé un poco más <Arrow diagonal /></a></div></section>
</BaseLayout>
