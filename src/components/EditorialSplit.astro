---
import { Image } from 'astro:assets';
import type { Photo } from '../data/site';
import Arrow from './Arrow.astro';
interface Props { eyebrow: string; title: string; text: string; href: string; label: string; photo?: Photo | null; }
const { eyebrow, title, text, href, label, photo } = Astro.props;
---
<section class="editorial-split wrap section-space">
  <div class="editorial-art">{photo ? <Image src={photo.src} alt={photo.alt} widths={[480, 800, 1200]} sizes="(max-width: 800px) 100vw, 50vw" format="webp" style={`object-position:${photo.position ?? 'center'}`} /> : <><div class="arch-art" aria-hidden="true"></div><p>La fe nos reúne.<br /><em>La comunidad nos acerca.</em></p><span class="eyebrow">Villa Sarmiento · Desde 2005</span></>}</div>
  <div class="editorial-copy"><p class="eyebrow">{eyebrow}</p><h2>{title}</h2><p>{text}</p><a class="text-link" href={href}>{label}<Arrow diagonal /></a></div>
</section>
