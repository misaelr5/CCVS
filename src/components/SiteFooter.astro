---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { groups } from '../data/links';
import SocialLinks from './SocialLinks.astro';
---
<footer class="site-footer">
 <Image class="footer-wordmark" src={site.logos.local} alt="" width={900} height={900} format="webp" loading="lazy" aria-hidden="true" />
 <div class="shell footer-grid">
  <div class="footer-identity">
   <Image src={site.logos.mother} alt="Comunidad Cristiana" width={64} height={64} format="webp" />
   <p>Comunidad Cristiana<br /><span>Villa Sarmiento</span></p>
  </div>
  {groups.slice(0, 2).map(group => <nav aria-label={group.title}><h2>{group.title}</h2>{group.links.map(link => <a href={link.href}>{link.label}</a>)}</nav>)}
  <div class="footer-contact"><h2>Encontranos</h2><address>{site.address}</address><a class="footer-visit" href="/visitanos/">Vení a una reunión <span aria-hidden="true">↗</span></a><a href="/links/">Canales de la congregación</a><SocialLinks label="Redes sociales del footer" /></div>
 </div>
 <div class="shell footer-bottom"><p>© {new Date().getFullYear()} CCVS</p><a href="/terminos-y-condiciones/">Términos y condiciones · borrador</a><a href="/politica-de-privacidad/">Política de privacidad</a><p>Villa Sarmiento · Córdoba, Argentina</p></div>
</footer>
