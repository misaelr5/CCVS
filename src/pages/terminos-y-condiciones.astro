---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollAccent from '../components/ScrollAccent.astro';
import { legal } from '../data/legal';
---
<BaseLayout title="Términos y condiciones" description="Condiciones de uso del sitio de Comunidad Cristiana Villa Sarmiento: contenidos, imágenes, actividades, privacidad y canales de contacto.">
  <section class="legal-page shell">
    <p class="kicker">COMUNIDAD CRISTIANA VILLA SARMIENTO</p>
    <h1>Términos y<br /><span class="serif">condiciones.</span></h1>
    <ScrollAccent kind="horizontal" />
    <p class="legal-updated">Última actualización: {legal.updated}.</p>
    <p class="legal-intro">{legal.intro}</p>
    {legal.sections.map((section, index) => <section>
      <h2>{index + 1}. {section.title}</h2>
      <p>{section.text}</p>
      {section.link && <p><a href={section.link.href}>{section.link.label}</a></p>}
    </section>)}
    <address class="legal-address"><strong>Comunidad Cristiana Villa Sarmiento</strong><br />Vélez Sarsfield s/n, Villa Sarmiento, Córdoba, Argentina.</address>
  </section>
</BaseLayout>
