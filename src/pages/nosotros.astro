---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutCover from '../components/AboutCover.astro';
import PhotoSection from '../components/PhotoSection.astro';
import BeliefsAccordion from '../components/BeliefsAccordion.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { history } from '../data/history';
---
<BaseLayout title="Nuestra fe en Jesucristo" description="Conocé la historia y las creencias de Comunidad Cristiana Villa Sarmiento, una congregación que sigue a Jesucristo.">
<AboutCover />
<section class="history-section shell section-gap" id="historia"><div class="history-heading"><PhotoSection photo={site.photos.history} label="Historia de nuestra comunidad" /><div><p class="kicker">Nuestra historia</p><h2>La oración nos reunió.<br /><span class="serif">El evangelio nos sigue convocando.</span></h2></div></div><div class="history-chapters">{history.map((chapter, index) => <article class="history-chapter"><p class="chapter-period">{chapter.period}</p><div><h3>{chapter.title}</h3><p>{chapter.text}</p>{chapter.note && <p class="chapter-note">{chapter.note}</p>}</div><span class="chapter-index" aria-hidden="true">0{index + 1}</span></article>)}</div></section>
<BeliefsAccordion />
<section class="identity shell section-gap"><div><h2>Comunidad Cristiana.<br /><span class="serif">En Villa Sarmiento.</span></h2><p>Somos una congregación local de Comunidad Cristiana. Nos reunimos para seguir a Jesucristo, aprender su Palabra y servir a nuestros vecinos.</p><a class="inline-link" href="/visitanos/">Vení a una reunión</a></div><div class="identity-marks"><Image src={site.logos.mother} alt="Emblema madre de Comunidad Cristiana" width={200} height={200} format="webp" /><Image src={site.logos.local} alt="CCVS — congregación local" width={220} height={220} format="webp" /></div></section>
</BaseLayout>
