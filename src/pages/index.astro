---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialHero from '../components/EditorialHero.astro';
import TextImageBlock from '../components/TextImageBlock.astro';
import PhotoSection from '../components/PhotoSection.astro';
import Schedule from '../components/Schedule.astro';
import { site } from '../data/site';
import PhotoCollage from '../components/PhotoCollage.astro';
import EditorialMark from '../components/EditorialMark.astro';
import Highlight from '../components/Highlight.astro';
import { schedule } from '../data/schedule';
const principal = schedule[0];
const youth = schedule.find(item => item.id === 'jovenes');
const children = schedule.find(item => item.id === 'ninos');
---
<BaseLayout title="Jesucristo, el camino al Padre" description="Conocé a Comunidad Cristiana Villa Sarmiento: una congregación que sigue a Jesucristo, estudia las Escrituras y se reúne para orar y servir.">
<EditorialHero />
<section class="home-welcome shell section-gap"><div class="welcome-collage"><PhotoCollage photos={[site.photos.welcome, site.photos.welcomeSecondary, site.photos.welcomeDetail]} label="La comunidad de Villa Sarmiento" /></div><div class="welcome-copy"><p class="kicker">Enseñanza, comunión y oración · Hechos 2:42</p><h2>En Cristo, <Highlight>crecemos juntos.</Highlight></h2><p class="large-serif">Aprender su Palabra.<br />Caminar en la fe.</p><p>Desde 2005, nuestra congregación comparte el evangelio y sirve a sus vecinos en Villa Sarmiento. Nos reunimos para orar y acompañarnos mientras seguimos a Jesús.</p><a class="inline-link" href="/nosotros/">Conocé nuestra historia y fe</a><EditorialMark kind="horizontal" class="welcome-pointer" /></div></section>
<section class="home-principal shell section-gap"><div class="principal-copy"><p class="kicker">ADORACIÓN Y COMUNIÓN</p><h2>{principal.title}</h2><p class="principal-day">{principal.day}</p><p class="principal-time">{principal.time} <small>hs</small></p><a class="pill" href="/visitanos/">Sumate a la reunión</a></div><PhotoSection photo={site.photos.gathering} label="Nuestra reunión general" kind="principal-photo" /></section>
<section class="home-banner shell section-gap" aria-label="La comunidad reunida"><PhotoSection photo={site.photos.banner} label="Un encuentro de nuestra congregación" kind="banner-photo" /><span class="banner-note">Cristo, cabeza de la iglesia · Colosenses 1:18</span><EditorialMark kind="x" class="banner-mark" /></section>
<section class="home-schedule shell section-gap" id="horarios"><h2>Reuniones.</h2><div class="schedule-showcase"><article class="schedule-feature"><PhotoSection photo={site.photos.gathering} label="Nuestra reunión general" kind="schedule-feature-photo" /><div class="schedule-feature-copy"><p class="kicker">Para orar y crecer en la fe</p><h3>{principal.title}</h3><p>{principal.day} · {principal.time} hs</p><a class="pill" href="/visitanos/">Cómo visitarnos</a></div></article><div class="schedule-showcase-list"><p class="schedule-showcase-intro">Compartimos la fe cada semana. Conocé los horarios regulares de nuestra congregación.</p><Schedule interactive /></div></div></section>
<TextImageBlock title="Una historia de oración y fe." eyebrow="Desde 2005, en Villa Sarmiento" photo={site.photos.community}><p>En 2005 comenzamos a reunirnos para orar en la casa de Esther Mercado. Aquel deseo de crecer espiritualmente y compartir el evangelio sigue siendo parte de nuestra historia.</p><a class="inline-link" href="/nosotros/#historia">Conocé nuestra historia</a></TextImageBlock>
<section class="community-features shell section-gap"><h2>La fe se comparte.<br /><span class="serif">De una generación a otra.</span></h2><div class="feature-pair"><a href="/ministerios/#ninos"><PhotoSection photo={site.photos.children} label="Niños" /><h3>Niños <span aria-hidden="true">↗</span></h3>{children && <p>{children.day} · {children.time} hs</p>}</a><a href="/ministerios/#jovenes"><PhotoSection photo={site.photos.youth} label="Jóvenes" /><h3>Jóvenes <span aria-hidden="true">↗</span></h3>{youth && <p>{youth.day} · {youth.time} hs</p>}</a></div><a class="inline-link" href="/ministerios/">Conocé las reuniones</a></section>
<section class="visit-invitation shell section-gap"><p class="kicker">Vení a una reunión</p><h2>Nos reunimos para adorar a Dios.<br /><span class="serif">Hay lugar para vos.</span></h2><address>{site.address}</address><a class="pill" href="/visitanos/">Horarios y primera visita</a></section>
</BaseLayout>
