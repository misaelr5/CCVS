---
import { Image } from 'astro:assets';
import poster from '../assets/photos/portada-video.jpg';
---
<div class="hero-media hero-video-media" data-hero-video>
 <Image src={poster} alt="Un encuentro de Comunidad Cristiana Villa Sarmiento" widths={[480,800,1280]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" class="hero-video-poster" />
 <!-- La imagen responsive ya funciona como poster; evita otra descarga fija a 1280px. -->
 <video muted loop playsinline preload="none" width="1280" height="720" data-video-src="/media/portada-ccvs.mp4" data-video-mobile="/media/portada-ccvs-mobile.mp4" aria-label="Video de nuestra comunidad"></video>
</div>
<div class="hero-video-controls" data-video-controls role="group" aria-label="Controles del video de portada" hidden>
 <button type="button" data-video-sound>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4Z"/><path class="sound-waves" d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/><path class="sound-off" d="m16 9 5 6m0-6-5 6"/></svg>
  <span>Activar sonido</span>
 </button>
 <button type="button" data-video-play><span>Reproducir video</span></button>
</div>
<p class="sr-only" data-video-status role="status"></p>
