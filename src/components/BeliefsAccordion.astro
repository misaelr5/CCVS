---
import { beliefs, beliefsClosing } from '../data/beliefs';
---
<section class="beliefs shell section-gap" id="creencias" aria-label="Fundamentos doctrinales">
  <div class="belief-list">
    {beliefs.map((item, index) => (
      <article>
        <h2>
          <button class="belief-trigger" type="button" aria-expanded="true" aria-controls={`belief-panel-${index}`} id={`belief-button-${index}`}>
            <span class="belief-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="belief-title">{item.title}</span>
            <span class="belief-symbol" aria-hidden="true">−</span>
          </button>
        </h2>
        <div class="belief-panel" id={`belief-panel-${index}`} role="region" aria-labelledby={`belief-button-${index}`}>
          <div class="belief-panel-inner">
            {item.paragraphs.map(paragraph => <p>{paragraph}</p>)}
          </div>
        </div>
      </article>
    ))}
  </div>
  <p class="beliefs-closing">{beliefsClosing}</p>
</section>
