---
import HeroVideo from './HeroVideo.astro';
import { editorial } from '../data/site';
import ScrollAccent from './ScrollAccent.astro';
---
<section class="editorial-hero shell"><HeroVideo /><div class="hero-copy"><h1><span class="hero-title-primary">{editorial.hero[0]}</span>{' '}<span class="hero-title-secondary">{editorial.hero.slice(1).join(' ')}</span></h1><p>{editorial.heroIntro}</p><a class="pill" href="/lo-que-creemos/">Conocé nuestra fe</a><ScrollAccent kind="diagonal" class="hero-accent" /></div></section>
