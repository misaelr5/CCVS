---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActivityCard from '../components/ActivityCard.astro';
import Invitation from '../components/Invitation.astro';
import { site } from '../data/site';
---
<BaseLayout title="Ministerios" description="Oración, estudio bíblico, niños, jóvenes y servicio comunitario en Comunidad Cristiana Villa Sarmiento.">
  <section class="page-intro simple-intro wrap"><p class="eyebrow">Ministerios y actividades</p><h1>{site.ministries.title}<br /><em>{site.ministries.accent}</em></h1><p class="intro-text">{site.ministries.text}</p></section>
  <section class="wrap activity-section" aria-label="Actividades de la comunidad"><div class="activity-grid ministries-grid">{site.activities.map((activity, index) => <ActivityCard activity={activity} index={index} />)}</div></section>
  <Invitation />
</BaseLayout>
