---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { groups, externalLinks, isHttpsUrl } from '../data/links';
---
<footer class="site-footer"><div class="shell footer-grid"><div class="footer-identity"><Image src={site.logos.mother} alt="Comunidad Cristiana" width={72} height={72} format="webp" /><p>{site.name}</p><Image class="secondary-logo" src={site.logos.local} alt="CCVS — identidad local" width={104} height={104} format="webp" /></div>{groups.slice(0, 2).map(group => <nav aria-label={group.title}><h2>{group.title}</h2>{group.links.map(link => <a href={link.href}>{link.label}</a>)}</nav>)}<div class="footer-contact"><h2>Encontranos</h2><address>{site.address}</address><a href="/links/">Nuestros enlaces</a>{externalLinks.filter(link => isHttpsUrl(link.href)).map(link => <a href={link.href} rel="noopener noreferrer">{link.label}</a>)}</div></div><div class="shell footer-bottom"><p>© {new Date().getFullYear()} CCVS</p><p>Comunidad Cristiana Villa Sarmiento</p></div><p class="footer-wordmark" aria-hidden="true">Comunidad Cristiana</p></footer>
