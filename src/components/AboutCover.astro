---
import PhotoSection from './PhotoSection.astro';
import { site, editorial } from '../data/site';
import ScrollAccent from './ScrollAccent.astro';
---
<section class="about-cover shell"><PhotoSection photo={site.photos.aboutCover} label="Vida de nuestra congregación" kind="about-media" eager /><div class="about-copy"><h1>Nuestra<br /> historia</h1><p class="editorial-statement">{editorial.about.map(line => <span>{line}</span>)}</p><p class="about-intro">{editorial.aboutIntro}</p><ScrollAccent kind="horizontal" /></div></section>

<style>
  @media (min-width:701px) {
    .about-cover.shell { width:calc(100% - 144px); max-width:1296px; margin-inline:auto; padding-top:32px; grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:clamp(36px,5vw,72px); align-items:stretch; }
    .about-cover :global(.about-media) { grid-column:2; grid-row:1; width:100%; height:100%; min-height:560px; max-height:660px; border-radius:20px; }
    .about-cover :global(.about-media img) { object-position:center 55%; }
    .about-copy { grid-column:1; grid-row:1; display:flex; flex-direction:column; min-width:0; padding:12px 0 0; }
    .about-cover .about-copy h1 { width:auto; max-width:100%; margin:0 0 clamp(32px,4vw,56px); padding:0; font-size:clamp(72px,7.2vw,104px); line-height:.94; letter-spacing:-.078em; }
    .about-cover .editorial-statement { max-width:510px; font-size:clamp(34px,3.2vw,46px); line-height:1.12; letter-spacing:-.065em; }
    .about-cover .editorial-statement span + span { margin-top:14px; }
    .about-cover .about-intro { max-width:440px; margin-top:clamp(30px,3vw,44px); font-size:16px; line-height:1.55; }
    .about-cover .about-copy :global(.scroll-accent) { margin-top:auto; padding-top:22px; }
  }
  @media (min-width:701px) and (max-width:1100px) {
    .about-cover.shell { width:calc(100% - 80px); gap:clamp(26px,4vw,44px); }
    .about-cover :global(.about-media) { min-height:500px; }
    .about-cover .about-copy h1 { font-size:clamp(65px,8vw,85px); }
    .about-cover .editorial-statement { font-size:clamp(32px,4vw,40px); }
  }
</style>
